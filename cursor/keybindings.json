// Place your key bindings in this file to override the defaults
[
  {
    "key": "cmd+m",
    "command": "aipopup.action.modal.generate",
    "when": "editorFocus && !composerBarIsVisible"
  },
  {
    "key": "shift+cmd+k",
    "command": "-aipopup.action.modal.generate",
    "when": "editorFocus && !composerBarIsVisible"
  },
  {
    "key": "cmd+k",
    "command": "-aipopup.action.modal.generate",
    "when": "editorFocus && !composerBarIsVisible"
  },
  {
    "key": "cmd+m",
    "command": "composer.openAsBar"
  },
  {
    "key": "shift+cmd+k",
    "command": "-composer.openAsBar"
  },
  {
    "key": "cmd+i",
    "command": "composerMode.agent"
  }
]
